{
  "name": "mapas-facil",
  "productName": "Mapas Facil",
  "private": true,
  "version": "0.5.1",
  "description": "Mapas Fácil — shell Electron + React (Fase 1). Ver Fase_1_Desktop/planos/02-ui-chat-e-workspace.md",
  "type": "module",
  "main": "dist/electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "dev:electron": "pnpm run build:electron && electron .",
    "build:renderer": "vite build",
    "build:electron": "node scripts/build-electron.mjs",
    "build": "pnpm run build:renderer && pnpm run build:electron",
    "build:nucleo": "node scripts/build-nucleo.mjs",
    "dist": "pnpm run build && pnpm run build:nucleo && electron-builder --win --publish never",
    "typecheck": "tsc -b --force",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "build": {
    "appId": "space.cursar.mapasfacil",
    "productName": "Mapas Facil",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "!**/*.map"
    ],
    "extraResources": [
      {
        "from": "../nucleo/dist/mapasfacil-nucleo",
        "to": "nucleo"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "MapasFacil-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Mapas Facil"
    }
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  },
  "dependencies": {
    "lucide-react": "^0.469.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "axe-core": "^4.12.1",
    "electron": "^33.3.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.24.2",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.6",
    "vitest": "^2.1.8"
  }
}
