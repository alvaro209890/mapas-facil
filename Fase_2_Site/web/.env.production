# Produção neste PC (mapasfacil.cursar.space) — URLs públicas, sem segredos.
#
# ATENÇÃO: `NEXT_PUBLIC_DOWNLOAD_*` tem precedência sobre o manifesto da release
# (ver lib/download.ts). Enquanto estiverem preenchidos, o site **ignora** o
# `download-manifest.json` publicado — toda release nova exige editar as 5
# linhas abaixo e reconstruir. Para o site seguir a release sozinho, apague
# `NEXT_PUBLIC_DOWNLOAD_URL` e deixe só o `_MANIFEST_URL`.
NEXT_PUBLIC_DOWNLOAD_MANIFEST_URL=https://github.com/alvaro209890/mapas-facil/releases/latest/download/download-manifest.json
# Sem pin: o site segue o `download-manifest.json` da última release. Preencher
# qualquer uma das cinco linhas abaixo volta a congelar a versão anunciada.
# NEXT_PUBLIC_DOWNLOAD_URL=
# NEXT_PUBLIC_DOWNLOAD_VERSION=
# NEXT_PUBLIC_DOWNLOAD_NAME=
# NEXT_PUBLIC_DOWNLOAD_SHA256=
# NEXT_PUBLIC_DOWNLOAD_BYTES=
NEXT_PUBLIC_DEVELOPER_NAME=Álvaro Emanuel
NEXT_PUBLIC_CONTACT_EMAIL=alvaroemanuel642@gmail.com
NEXT_PUBLIC_WHATSAPP_NUMBER=5566984396232
NEXT_PUBLIC_REPO_URL=https://github.com/alvaro209890/mapas-facil
